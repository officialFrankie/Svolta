# Copia questo file in .env (letto da Prisma CLI e da Next) e compila i valori.

# Chiave API Anthropic — SOLO lato server, mai esposta al client.
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL (Neon). Su Vercel la variabile esiste già (integrazione Neon).
# In locale: crea un branch/database Neon di sviluppo o usa un Postgres locale.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- FASE 2 (non ancora attiva) ---
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=https://<tua-app>.vercel.app/api/whoop/callback
