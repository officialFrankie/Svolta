# Copia questo file in .env.local e compila i valori.

# Chiave API Anthropic — SOLO lato server, mai esposta al client.
ANTHROPIC_API_KEY=sk-ant-...

# Database SQLite locale (default, nessun servizio esterno).
DATABASE_URL="file:./dev.db"

# --- OPZIONALE: solo per deploy su Vercel (filesystem effimero) ---
# Se valorizzati, l'app usa Turso (libSQL) al posto del file SQLite.
# TURSO_DATABASE_URL=libsql://svolta-<tuo-nome>.turso.io
# TURSO_AUTH_TOKEN=...

# --- FASE 2 (non ancora attiva) ---
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=https://<tua-app>.vercel.app/api/whoop/callback
